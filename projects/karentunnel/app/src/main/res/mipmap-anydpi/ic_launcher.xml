<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon for API < 26.

  The only icon previously defined lived in mipmap-anydpi-v26, which means
  anything below API 26 had no launcher icon at all and would fall back to the
  system default. minSdk here is 26, so this is the belt to the adaptive icon's
  braces, and it also stops tooling from resolving @mipmap/ic_launcher to
  nothing on older resource configurations.

  Vector drawables are supported as launcher icons from API 21 onward.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Background plate -->
    <path
        android:fillColor="#1F6FEB"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Same neutral shield as the adaptive foreground, no lock metaphor -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,26 L76,36 L76,56 C76,68 66,78 54,82 C42,78 32,68 32,56 L32,36 Z" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Tunnel configs contain private keys. They are excluded from both cloud backup
  and device-to-device transfer, and the Keystore key is non-exportable anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="tunnels" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="tunnels" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
